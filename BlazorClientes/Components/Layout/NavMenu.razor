            </span>

            <span>Início</span>
        </NavLink>

        <NavLink class="navigation-link"
                 href="clientes"
                 @onclick="Navegar">

            <span class="navigation-icon">
                👥
            </span>

            <span>Clientes</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <div class="technology">
